# Optional OpenAI voice. Keep the permanent key on the server.
OPENAI_API_KEY=
# Required when exposing an OpenAI-enabled server beyond loopback.
MCP_AUTH_TOKEN=
# Local defaults:
HOST=127.0.0.1
PORT=4317
# For remote hosting, configure HTTPS reverse proxy and these values:
PUBLIC_ORIGIN=
# Unique widget origin required for public directory submission:
WIDGET_ORIGIN=
